[Unit]
Description=Ephemeral host-controld process-boundary probe %i

[Service]
Type=simple
User=daemon
Group=daemon
ExecStart=/bin/sh /run/host-sessiond-control-test/worker %i
Restart=no
KillMode=process
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
