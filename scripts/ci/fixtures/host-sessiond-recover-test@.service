[Unit]
Description=Ephemeral host-controld recovery probe %i
After=host-sessiond@%i.service
Conflicts=host-sessiond@%i.service

[Service]
Type=oneshot
User=daemon
Group=daemon
ExecStart=/bin/sh /run/host-sessiond-control-test/recover %i
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
